# Copy to .env.local (never commit .env.local).

# Canonical URL used for Open Graph / JSON-LD. Set to the production domain once live.
NEXT_PUBLIC_SITE_URL=https://middle-georgia-hvac-demo.vercel.app

# OPTIONAL — lead form delivery.
# 1) Create a free form at https://formspree.io, paste its ID here, and the form
#    will POST there instead of opening the visitor's mail app.
# 2) In Formspree, enable the SMS / email-to-text notification so every lead
#    lands on Jessie's phone as a text.
# NEXT_PUBLIC_FORMSPREE_ID=xxxxxxxx
